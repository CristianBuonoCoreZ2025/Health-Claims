# Variables de entorno de Health Claims.
# Copia este archivo a .env.local y completa los valores desde el dashboard de Supabase.
# NUNCA commitees .env.local (esta en .gitignore).

# --- Supabase (publicas, expuestas al cliente) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# --- Supabase (secreta, SOLO server) ---
# Usar unicamente en Server Components, Route Handlers, Server Actions y Edge Functions.
# NUNCA importar en codigo del cliente (src/lib/supabase/client.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# --- Generacion de tipos (npm run db:gen) ---
# Project ref del proyecto Supabase (visible en el dashboard > Project Settings).
SUPABASE_PROJECT_ID=tu-project-ref
